#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys

# Locate native binaries
AGY_BIN = shutil.which("agy") or os.path.expanduser("~/.local/bin/agy") or "/usr/bin/agy"
GCLOUD_BIN = shutil.which("gcloud") or "/usr/bin/gcloud"
REAL_HOME = os.path.expanduser("~")

# Isolated sandbox directory for sub-cli runs to avoid loading ~/.gemini MCP servers (prevents recursion deadlocks)
SANDBOX_HOME = os.path.join(REAL_HOME, ".gemini", "antigravity-mcp-sandbox")

def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()

def ensure_sandbox():
    """Ensure an isolated home environment with symlinked credentials and no MCP recursive loops."""
    gcloud_dir = os.path.join(SANDBOX_HOME, ".config", "gcloud")
    os.makedirs(gcloud_dir, exist_ok=True)
    
    src_adc = os.path.join(REAL_HOME, ".config", "gcloud", "application_default_credentials.json")
    dst_adc = os.path.join(gcloud_dir, "application_default_credentials.json")
    if os.path.exists(src_adc) and not os.path.exists(dst_adc):
        try:
            os.symlink(src_adc, dst_adc)
        except OSError:
            shutil.copy2(src_adc, dst_adc)

def check_adc():
    """Verify host ADC token validity natively without containers."""
    if not os.path.exists(os.path.expanduser("~/.config/gcloud/application_default_credentials.json")):
        return False
    res = subprocess.run(
        [GCLOUD_BIN, "auth", "application-default", "print-access-token"],
        capture_output=True, text=True
    )
    return res.returncode == 0

ensure_sandbox()

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        req = json.loads(line)
    except json.JSONDecodeError:
        continue
    
    # Ignore protocol notifications lacking request IDs (e.g. notifications/initialized)
    if "id" not in req:
        continue

    req_id = req.get("id")
    method = req.get("method")

    if method == "initialize":
        send({
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "agy-gcp-bridge", "version": "2.0.0"}
            }
        })
    elif method == "tools/list":
        send({
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "tools": [{
                    "name": "ask_gemini_carbon",
                    "description": "Query Gemini 4 Carbon or Claude Opus 5.5 on Google Cloud Agent Platform via Antigravity CLI in native ADC mode.",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "prompt": {"type": "string", "description": "Prompt or instruction for model"},
                            "model": {"type": "string", "default": "gemini-4-carbon-medium"}
                        },
                        "required": ["prompt"]
                    }
                }]
            }
        })
    elif method == "tools/call":
        if not check_adc():
            send({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": "Native Google Cloud ADC token missing or expired. Run 'gcp-auth-refresh' in your terminal."}],
                    "isError": True
                }
            })
            continue

        args = req.get("params", {}).get("arguments", {})
        prompt = args.get("prompt", "")
        model = args.get("model", "gemini-4-carbon-medium")

        # Normalize model names if user omits reasoning effort tier
        if model in ("gemini-4-carbon", "gemini-carbon"):
            model = "gemini-4-carbon-medium"

        env = os.environ.copy()
        env["HOME"] = SANDBOX_HOME
        env["AGY_ADC_AUTH"] = "true"
        env["GOOGLE_GENAI_USE_VERTEXAI"] = "True"

        proc = subprocess.run(
            [AGY_BIN, "--disable-slash-commands", "--model", model, "-p", prompt],
            env=env, capture_output=True, text=True
        )
        output = proc.stdout if proc.returncode == 0 else f"Execution Error ({proc.returncode}): {proc.stderr}"
        send({
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "content": [{"type": "text", "text": output}],
                "isError": proc.returncode != 0
            }
        })
